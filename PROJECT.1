#include<stdio.h>
int main()
{
int a,b,choice;
printf("enter a number");
scanf("%d %d",&a,&b);
printf("1.addition");
printf("2.subraction");
printf("3.multiplication");
printf("4.division");
printf("enter your choice");
scanf("%d",&choice);
switch(choice)
{
case 1:
printf("sum=%d",a+b);
break;
case 2:
printf("sub=%d",a-b);
break;
case 3:
printf("mul=%d",a*b);
break;
case 4:
printf("div=%d",a/b);
break;
default:
printf("invalid choice");
}
return 0;
}
